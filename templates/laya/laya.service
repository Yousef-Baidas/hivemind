# laya for hivemind lesson recall: GPU only, loopback only. `node install.js --laya setup`
# prints how to install it; copy to ~/.config/systemd/user/, then systemctl --user enable --now laya.
[Unit]
Description=laya classifier for hivemind lesson recall (127.0.0.1:47311, CUDA)

[Service]
ExecStart=%h/.local/share/laya/venv/bin/laya-serve
Environment=LAYA_HOST=127.0.0.1 LAYA_PORT=47311 LAYA_DEVICE=cuda LAYA_MODELS=multilingual LAYA_PRELOAD=1
Environment=LAYA_MAX_LOADED=1 LAYA_MAX_TOKEN_BUDGET=1024 LAYA_LOG_LEVEL=warning
# hand VRAM back after each request (~1.5 GB idle instead of the largest request's peak)
Environment=PYTORCH_NO_CUDA_MEMORY_CACHING=1
# a CUDA OOM falls back to the CPU; the cap kills laya then, not the desktop
MemoryMax=5G
MemorySwapMax=0
Restart=on-failure

[Install]
WantedBy=default.target
